# ==== IDX Scraper config ====

# Storage backend: "sqlite" (default, no setup) atau "postgres"
IDX_STORAGE=sqlite

# Path file SQLite lokal (dipakai kalau IDX_STORAGE=sqlite)
IDX_SQLITE_PATH=./data/idx.db

# ---- Watchlist emiten (pisah koma, tanpa .JK) ----
IDX_WATCHLIST=BBCA,BBRI,BMRI,TLKM,ASII
# File .env tempat perubahan watchlist (via API/CLI) ditulis. Default .env
# di akar repo; timpa kalau .env produksi ada di lokasi lain.
# IDX_ENV_FILE=

# ---- API (FastAPI, `python -m idx_scraper.api.serve`) ----
# Origin frontend yang diizinkan CORS (pisah koma) - idx-web/web di :3000,
# :3100 dipakai lingkungan dev kedua. Tambahkan domain produksi di sini.
# IDX_API_CORS_ORIGINS=http://localhost:3000,http://localhost:3100
# Ukuran pool koneksi Postgres proses API.
# IDX_API_POOL_MIN=1
# IDX_API_POOL_MAX=10
# Base URL API dari sisi scraper - dipakai job refresh untuk POST
# /api/cache/clear supaya menu dashboard langsung menyajikan data baru
# (best-effort; kalau API mati, TTL 1 jam jadi jaring).
# IDX_API_BASE=http://127.0.0.1:8000

IDX_INDEX_INTERVAL=60
IDX_WATCHLIST_INTERVAL=60

# ---- Live capture per-emiten (job rolling saat `serve`) ----
# GetStockSummary whole-market hanya EOD, jadi feed live ditark satu kode
# per satu request dalam sweep berputar (self-gate jam bursa + sumber IDX).
# Jumlah emiten likuid yang ditangkap; 0 = matikan live capture.
# IDX_LIVE_TOP=60
# Jeda antar-request per emiten (milidetik) - disiplin rate-limit IDX.
# IDX_LIVE_DELAY_MS=2000

# ---- Polling interval (detik) ----
# 60 = default yang disarankan. Nilai kecil melipatgandakan ukuran tabel
# public.index_quotes: 60s -> ~1,1 GB/tahun, 15s -> ~4,5 GB/tahun (45 indeks
# x ~360 poll/hari pada 60s). Turunkan hanya kalau server punya disk lega.
IDX_INDEX_INTERVAL=60
IDX_WATCHLIST_INTERVAL=60

# ---- Transport IDX (Cloudflare) ----
# auto   = coba HTTP murni (curl_cffi) dulu; jatuh ke Chrome HANYA bila ditolak (default)
# http   = tanpa browser sama sekali -> WAJIB kalau server tanpa Chrome (Linux)
# browser= selalu pakai Chrome headful (butuh Google Chrome + extra [browser])
IDX_TRANSPORT=auto
# Target fingerprint curl_cffi. Satu-satunya tombol bila Cloudflare memperketat.
# 16 Okt 2026: keluarga Chrome ditolak 403; safari18_0 & firefox135 dijawab 200.
# IDX_IMPERSONATE=safari18_0
# Lama jalur HTTP diistirahatkan (detik) setelah ditolak, sebelum jatuh ke browser (mode auto).
# IDX_HTTP_COOLDOWN_SEC=600
# Folder profil Chrome. HANYA dipakai mode browser/auto-fallback. Kosongkan di Linux.
# IDX_CHROME_PROFILE_DIR=

# ---- Jadwal & kesegaran EOD ----
# Interval probe ketersediaan IDX (detik) — dipakai auto-switch sumber.
IDX_PROBE_INTERVAL=900
# Interval tarik berita Snips (detik), 24/7 tanpa gate jam bursa.
NEWS_INTERVAL=900
# Sejak jam ini (WIB) EOD hari ini dianggap telat -> alarm `health_eod` (17:45)
# dan exit code `idx health`. Default 17:30, bukan 16:00: ringkasan EOD per saham
# IDX diukur baru terbit 17:13-17:16 (16 & 19 Okt 2026), jadi tenggat 16:00
# membuat alarm berbunyi tiap hari bursa sementara datanya belum ada di mana pun.
# WAJIB <= jam job health_eod, kalau tidak alarm tidak pernah berbunyi.
IDX_EOD_DEADLINE_HOUR=17
IDX_EOD_DEADLINE_MINUTE=30
# Backfill hari bursa lampau yang bolong (dipakai saat `serve` start & tiap tick
# jaring sore `eod_fallback`). 21 = ~1 bulan kalender: cukup untuk mesin yang
# tidur/off berminggu-minggu, tanpa menjelajah setahun saat laptop baru dinyalakan.
# 0 = matikan. Hanya SAHAM yang ditarik ulang; close indeks lampau tidak punya
# sumber non-live, jadi tanggal itu dilaporkan saja saat startup.
IDX_BACKFILL_DAYS=21
# Hari libur bursa (ISO, pisah koma). Tanpa ini, hari libur nasional dianggap
# hari bursa -> alarm EOD palsu + notifikasi Telegram tiap libur.
# Kalender resmi BEI 2026 (SKB Tiga Menteri No. 1497/2/5 Tahun 2025):
# 22 tanggal di bawah. Tanggal yang sudah lewat tidak mengganggu (hanya dipakai
# untuk menelusuri hari bursa terakhir). Kalender 2027 belum terbit — tambahkan
# saat BEI mengumumkan.
IDX_HOLIDAYS=2026-01-01,2026-01-16,2026-02-16,2026-02-17,2026-02-18,2026-02-19,2026-03-20,2026-03-23,2026-03-24,2026-04-03,2026-05-01,2026-05-14,2026-05-15,2026-05-27,2026-05-28,2026-06-01,2026-06-16,2026-08-17,2026-08-25,2026-12-24,2026-12-25,2026-12-31

# ---- Jam bursa (WIB) untuk membatasi polling ----
IDX_MARKET_OPEN=09:00
IDX_MARKET_CLOSE=16:00

# ---- Alert Telegram (opsional) ----
# 1. Bikin bot via @BotFather -> dapat token
# 2. Chat /start ke bot, lalu ambil chat_id via getUpdates
# 3. Kosongkan untuk mematikan alert
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Interval scan sinyal saat `idx serve` (detik)
IDX_ALERT_INTERVAL=300
# File state dedup alert (relatif ke cwd)
IDX_SIGNAL_STATE=.signal_state.json

# ---- Aturan pantauan (dibuat dari halaman Pantau di dashboard) ----
# Daftar aturan harga/RSI/volume yang dipantau dan dikirim via Telegram
IDX_ALERTS_PATH=./data/alerts.json
# Latch anti-spam: aturan hanya dikirim sekali per persilangan threshold
IDX_ALERT_STATE=./data/alert_state.json

# ---- Alert kandidat beli (halaman Rekomendasi) ----
# Latch anti-spam: kandidat hanya dikirim saat BARU masuk grade A
IDX_RECOMMENDATION_STATE=./data/recommendation_state.json

# ---- Logging terpusat (dipakai semua perintah `idx`) ----
# Level minimal record yang ditulis (DEBUG/INFO/WARNING/ERROR)
IDX_LOG_LEVEL=INFO
# Direktori berkas log harian (idx-YYYYMMDD.log, rotasi 5 MB x 5).
# Kosong = hanya stderr. DSN & token otomatis disamarkan di semua handler.
IDX_LOG_DIR=

# application_name tiap koneksi Postgres (terlihat di pg_stat_activity).
# Hanya perlu diubah kalau lebih dari satu instans scraper berjalan di host sama.
IDX_DB_APP_NAME=idx-scraper

# ---- Berkas state & lock (opsional) ----
# Kunci single-instance `serve`: dua `serve` = dua Chrome berebut profil yang
# sama -> EOD masuk 0 baris. Default di LOCALAPPDATA (Windows) atau
# ~/.local/state (Linux); timpa bila perlu lokasi lain.
# IDX_SERVE_LOCK=
# File state verdict smart money (deteksi perubahan verdict antar-run).
# Default: data/smart_money_state.json di akar repo.
# IDX_SMART_MONEY_STATE=./data/smart_money_state.json
# Gerbang halt manual klaim jurnal (P6) - berkas JSON, bukan tabel.
# Default: data/journal_halt.json di akar repo; diisi `idx journal halt`.
# IDX_JOURNAL_HALT=./data/journal_halt.json
# Diisi nilai apa pun (mis. 1) = cache ranking/bobot composite dinonaktifkan.
# Untuk debugging; produksi biarkan kosong.
# IDX_COMPOSITE_NO_CACHE=

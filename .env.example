# ==== IDX Scraper config ====

# Storage backend: "sqlite" (default, no setup), "postgres", atau "supabase"
IDX_STORAGE=sqlite

# Path file SQLite lokal (dipakai kalau IDX_STORAGE=sqlite)
IDX_SQLITE_PATH=./data/idx.db

# ---- Generic PostgreSQL (dipakai kalau IDX_STORAGE=postgres) ----
# DATABASE_URL diprioritaskan; kalau kosong fallback ke SUPABASE_DB_URL.
# Contoh: postgresql://user:pass@host:5432/idx
# DATABASE_URL=

# ---- Supabase / Postgres (dipakai kalau IDX_STORAGE=supabase) ----
# Ambil dari: Supabase Dashboard > Project Settings > Database > Connection string (URI)
# Gunakan connection pooler (port 6543) untuk polling yang sering.
# Contoh: postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=

# ---- Watchlist emiten (pisah koma, tanpa .JK) ----
IDX_WATCHLIST=BBCA,BBRI,BMRI,TLKM,ASII

# ---- Polling interval (detik) ----
IDX_INDEX_INTERVAL=15
IDX_WATCHLIST_INTERVAL=30

# ---- Jam bursa (WIB) untuk membatasi polling ----
IDX_MARKET_OPEN=09:00
IDX_MARKET_CLOSE=16:00

# ---- Alert Telegram (opsional) ----
# 1. Bikin bot via @BotFather -> dapat token
# 2. Chat /start ke bot, lalu ambil chat_id via getUpdates
# 3. Kosongkan untuk mematikan alert
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Interval scan sinyal saat `idx serve` (detik)
IDX_ALERT_INTERVAL=300
# File state dedup alert (relatif ke cwd)
IDX_SIGNAL_STATE=.signal_state.json
